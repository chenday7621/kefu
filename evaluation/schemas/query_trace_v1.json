{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterX per-query trace V1",
  "type": "object",
  "required": ["schema_version", "trace_id", "worker_id", "concurrency", "stage_timings_ms", "stage_status", "calls", "tokens", "model_calls", "models", "fallbacks", "cache", "retry_count", "timeout_count", "total_ms"],
  "properties": {
    "schema_version": {"const": "query-trace-v1"},
    "trace_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "integer"},
    "concurrency": {"type": "integer", "minimum": 1},
    "stage_timings_ms": {"type": "object"},
    "stage_status": {"type": "object"},
    "calls": {"type": "object"},
    "tokens": {"type": "object"},
    "model_calls": {"type": "array"},
    "models": {"type": "object"},
    "fallbacks": {"type": "array"},
    "cache": {"type": "object"},
    "retry_count": {"type": "integer", "minimum": 0},
    "timeout_count": {"type": "integer", "minimum": 0},
    "total_ms": {"type": "number", "minimum": 0}
  }
}
